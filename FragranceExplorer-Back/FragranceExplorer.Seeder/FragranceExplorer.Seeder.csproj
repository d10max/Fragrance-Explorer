<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>e783a7ba-3632-4cb2-8e0f-af339e33e9b7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FragranceExplorer.BLL\FragranceExplorer.BLL.csproj" />
    <ProjectReference Include="..\FragranceExplorer.DAL\FragranceExplorer.DAL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="9.0.21" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.21" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
